# Tuned baseline — established improvements over upstream
# Source these on top of upstream_baseline.env
# Only contains values that DIFFER from upstream.

# Architecture scaling (more capacity within 16MB budget)
NUM_LAYERS=11          # upstream=9, +2 layers fits budget
MLP_MULT=3.0           # upstream=2, wider MLPs
TRAIN_SEQ_LEN=2048     # upstream=1024, 2x context
EVAL_SEQ_LEN=2048      # match train seq len
TRAIN_BATCH_TOKENS=786432  # upstream=524288, 1.5x throughput

# Warmdown fix (see NOTES.md) — proportional to total steps, not wallclock
WARMDOWN_ITERS=4000    # upstream=1200, matches leader #1

# Optimizer tuning
TIED_EMBED_LR=0.035    # upstream=0.05
MATRIX_LR=0.025        # upstream=0.04
SCALAR_LR=0.025        # upstream=0.04
MUON_MOMENTUM=0.99     # upstream=0.95
MUON_MOMENTUM_WARMUP_START=0.92  # upstream=0.85
MUON_MOMENTUM_WARMUP_STEPS=1500  # upstream=500
GRAD_CLIP_NORM=0.3     # upstream=0.0 (no clipping)
MUON_BETA2=0.95        # new param, not in upstream

# Weight averaging
SWA_ENABLED=1
SWA_EVERY=50
ADAM_WD=0.04
MUON_WD=0.04

# Logging cadence (less frequent for longer runs)
EVAL_STRIDE=64         # both leaders use 64
BIGRAM_VOCAB_SIZE=2048 # both leaders use 2048
BIGRAM_DIM=128         # both leaders use 128

# Logging cadence (less frequent for longer runs)
VAL_LOSS_EVERY=4000    # upstream=1000
TRAIN_LOG_EVERY=500    # upstream=200
